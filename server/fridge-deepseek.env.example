# /etc/fridge-deepseek.env 示例
#
# 使用方法：
# 1. 在服务器上执行：
#    sudo nano /etc/fridge-deepseek.env
# 2. 按照本文件格式填写。
# 3. 把 DEEPSEEK_API_KEY 改成你的真实 DeepSeek API Key。
# 4. 保存后执行：
#    sudo chmod 600 /etc/fridge-deepseek.env
#    sudo systemctl restart fridge-deepseek.service

DEEPSEEK_API_KEY=在这里填写你的DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 千问实时语音识别和语音合成。
# API Key 只放在服务器环境文件中，不要写进 Python 或单片机源码。
DASHSCOPE_API_KEY=在这里填写你的千问_API_Key
DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference/
FRIDGE_ASR_MODEL=fun-asr-realtime
FRIDGE_TTS_MODEL=cosyvoice-v3-flash
FRIDGE_TTS_VOICE=longxiaochun_v3

# MCU 与服务器音频协议使用的设备密钥。
# 正式部署时生成随机长字符串，并在 MCU 的 audio_voice_config.h 中填写相同值。
FRIDGE_AUDIO_TOKEN=请替换为随机设备密钥

# RA6M5安全OTA。设备端ota_update_config.h需要填写相同的OTA Token。
FRIDGE_OTA_TOKEN=请替换为另一个随机设备密钥
FRIDGE_OTA_DEVICE_ID=fridge-main-01
FRIDGE_OTA_TARGET_PART=R7FA6M5BF2CBG

# 这里只放ECDSA-P256公钥。签名私钥只保存在开发电脑，绝不能上传服务器。
FRIDGE_FIRMWARE_PUBLIC_KEY=/etc/fridge-firmware-public.pem

# 0.0.0.0 表示允许 W800 从公网连接进来。
FRIDGE_BIND_HOST=0.0.0.0

# 必须和单片机 deepseek_bridge.c 里的 BRIDGE_SERVER_PORT 一致。
FRIDGE_BIND_PORT=10086

# 手机 App HTTP API。安全组需要额外开放 10087/TCP。
FRIDGE_HTTP_HOST=0.0.0.0
FRIDGE_HTTP_PORT=10087

# 手机 App 请求头 X-Fridge-Token 必须填写这个值。
# 第一次调试可以先用这个默认值，正式使用建议改成你自己的长密码。
FRIDGE_APP_TOKEN=fridge-app-token

# DeepSeek API 最长等待秒数。
DEEPSEEK_TIMEOUT_SECONDS=90

# 药瓶仓储 JSON 保存文件。重启服务器后药品信息仍保存在这里。
MEDICINE_DB_PATH=/opt/fridge-deepseek/medicine_store.json

# 可视化控制台持久化数据库与静态页面目录。
DASHBOARD_DB_PATH=/opt/fridge-deepseek/dashboard.db
DASHBOARD_WEB_ROOT=/opt/fridge-deepseek/web

# 固件中心的实际文件目录（数据库只保存元数据和SHA-256）。
FIRMWARE_ROOT=/opt/fridge-deepseek/firmware

# 网页高级管理控制台管理员密码哈希。
# 在服务器部署目录执行 generate_admin_password.py，把输出的整行复制到等号后面。
DASHBOARD_ADMIN_PASSWORD_HASH=

# 当前使用公网 HTTP 演示时必须显式设为 1；切换 HTTPS 后建议改为 0。
DASHBOARD_ALLOW_INSECURE_ADMIN=1

# HTTP 演示为 0；使用 HTTPS 后改为 1，使管理会话 Cookie 只能通过 HTTPS 发送。
DASHBOARD_COOKIE_SECURE=0

# 日志级别，调试时可改成 DEBUG。
LOG_LEVEL=INFO
